<Window x:Class="AnyOTPManager.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AnyOTPManager" Icon="Assets/AnyOTPManager.ico" Style="{StaticResource {x:Type Window}}" Width="1240" Height="830" MinWidth="1040" MinHeight="650"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid Background="#F5F7FB">
  <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101E33">
   <Grid Margin="22,32,22,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Border Background="#19374B" Width="46" Height="46" CornerRadius="13" HorizontalAlignment="Left" Margin="0,0,0,18">
      <Viewbox Width="26" Height="26"><Canvas Width="30" Height="30">
       <Path Data="M15,2 L26,6 L26,15 C26,21 21,26 15,29 C9,26 4,21 4,15 L4,6 Z" Stroke="#53DDD2" StrokeThickness="2" Fill="Transparent"/>
       <Ellipse Canvas.Left="12" Canvas.Top="10" Width="6" Height="6" Stroke="#53DDD2" StrokeThickness="2"/>
       <Path Data="M15,16 L15,21" Stroke="#53DDD2" StrokeThickness="2"/>
      </Canvas></Viewbox>
     </Border>
     <TextBlock Text="AnyOTP" Foreground="White" FontSize="25" FontWeight="Bold"/>
     <TextBlock Text="MANAGER" Foreground="#8396B2" FontSize="11" FontWeight="SemiBold" Margin="1,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,42,0,0">
     <Border Background="#203650" CornerRadius="8" Padding="13,13" Margin="-4,0,-4,8">
      <DockPanel><TextBlock x:Name="SidebarCount" Text="0" DockPanel.Dock="Right" Foreground="#8EE0D8" FontWeight="SemiBold"/>
       <TextBlock Text="▦   Tüm kayıtlar" Foreground="White" FontWeight="SemiBold"/></DockPanel>
     </Border>
     <Button x:Name="SidebarLocalAddButton" Content="＋   Bu bilgisayardan ekle" Click="AddLocal_Click" Background="Transparent" Foreground="#C0CDDE" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,13"/>
     <Button x:Name="SidebarAddButton" Content="＋   Dosyadan ekle" Click="Add_Click" Background="Transparent" Foreground="#C0CDDE" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,13"/>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <Border BorderBrush="#2B3B51" BorderThickness="0,1,0,0" Padding="0,20,0,0">
      <StackPanel>
       <TextBlock Text="●  Çevrimdışı çalışır" Foreground="#7FD8CA" FontSize="12"/>
       <TextBlock Text="Kayıtlarınız bu Windows&#10;hesabında korunur." Foreground="#8396B2" FontSize="12" LineHeight="19" Margin="0,10,0,12"/>
       <Button Content="Kayıt klasörünü aç ↗" Click="Folder_Click" Background="Transparent" Foreground="#B1C1D7" BorderThickness="0" HorizontalContentAlignment="Left" Padding="0,5" FontSize="12"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="32,30,30,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel>
    <Button x:Name="AddButton" Content="＋  Kayıt ekle" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Add_Click" VerticalAlignment="Center" Margin="24,0,0,0"/>
    <StackPanel>
     <TextBlock Text="OTP kayıtlarınız" FontSize="28" FontWeight="SemiBold"/>
     <TextBlock Text="Güncel kodlarınız, tek bir yerde." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
    </StackPanel>
   </DockPanel>
   <Grid Grid.Row="1" Margin="0,26,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid MaxWidth="420" HorizontalAlignment="Left" Width="360">
     <TextBox x:Name="SearchBox" AutomationProperties.Name="Kayıt ara" Padding="36,10,10,10" TextChanged="Search_Changed"/>
     <TextBlock Text="⌕" FontSize="23" Foreground="#79879B" Margin="11,3,0,0" IsHitTestVisible="False"/>
     <TextBlock x:Name="SearchHint" Text="Kayıt adına göre ara…" Foreground="#7D8999" Margin="37,12,0,0" IsHitTestVisible="False"/>
    </Grid>
    <TextBlock x:Name="CountLabel" Grid.Column="1" Text="Kayıtlar açılıyor…" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
   </Grid>
   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
    <Grid>
     <ListBox x:Name="Cards" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              SelectionChanged="Cards_SelectionChanged" Padding="0" HorizontalContentAlignment="Stretch">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Width" Value="258"/><Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
         <Border x:Name="CardBorder" CornerRadius="12" Background="White" BorderBrush="#E0E6ED" BorderThickness="1" Padding="20">
          <ContentPresenter/>
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#159B96"/><Setter TargetName="CardBorder" Property="Background" Value="#F4FCFA"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#86C7C0"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel>
        <DockPanel Margin="0,0,0,16">
         <Border DockPanel.Dock="Left" Background="#E5F2F0" CornerRadius="7" Width="31" Height="31" Margin="0,0,11,0">
          <TextBlock Text="{Binding Initial}" Foreground="#087E83" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
         </Border>
         <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock Text="{Binding FormattedCode}" FontFamily="Consolas" FontSize="33" FontWeight="SemiBold" AutomationProperties.Name="Güncel OTP"/>
        <DockPanel Margin="0,10,0,10"><TextBlock Text="Yenilenmesine" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Countdown}" HorizontalAlignment="Right" FontSize="12" Foreground="#087E83" FontWeight="SemiBold"/></DockPanel>
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100"/>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22" MaxWidth="320">
      <Border Width="70" Height="70" Background="#E3EFEE" CornerRadius="22" Margin="0,0,0,20">
       <TextBlock Text="＋" Foreground="#087E83" FontSize="37" VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="EmptyTitle" Text="İlk OTP kaydınızı ekleyin" FontSize="21" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock x:Name="EmptyDescription" Text="Bu bilgisayardaki AnyOTP kaydını veya TXT ve REG dosyalarınızı ekleyin. Kodlarınız burada otomatik yenilenir." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,12,0,22"/>
      <Button x:Name="EmptyAddButton" Content="Dosyadan kayıt ekle" Style="{StaticResource PrimaryButton}" Click="Add_Click" HorizontalAlignment="Center"/>
     </StackPanel>
    </Grid>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Background="White" CornerRadius="12" BorderBrush="#E0E6ED" BorderThickness="1" VerticalAlignment="Top" Padding="22">
     <StackPanel>
      <TextBlock Text="KAYIT AYRINTILARI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,19"/>
      <StackPanel x:Name="DetailEmpty"><TextBlock Text="Bir kayıt seçin" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Kod kopyalama, PIN ve aktarım işlemleri burada görünür." Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel>
      <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
       <TextBlock Text="{Binding Alias}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,20"/>
       <TextBlock Text="{Binding FormattedCode}" FontFamily="Consolas" FontSize="32" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding CountdownDescription}" FontSize="12" Foreground="#087E83" Margin="0,6,0,18"/>
       <Button x:Name="CopyButton" Content="Kodu kopyala" Click="Copy_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"/>
       <Button x:Name="TransferButton" Content="Bu bilgisayara aktar" Click="Transfer_Click" Margin="0,0,0,10"/>
       <Button x:Name="PinButton" Content="PIN değiştir" Click="Pin_Click" Margin="0,0,0,16"/>
       <Border BorderThickness="0,1,0,0" BorderBrush="#E7ECF1" Padding="0,10,0,0">
        <StackPanel>
         <Button x:Name="RenameButton" Content="Adı düzenle" Click="Rename_Click" Style="{StaticResource QuietButton}" Padding="0,8"/>
         <Button x:Name="ExportButton" Content="TXT + REG dışa aktar" Click="Export_Click" Style="{StaticResource QuietButton}" Padding="0,8"/>
         <Button x:Name="DeleteButton" Content="Kaydı kaldır" Click="Delete_Click" Style="{StaticResource QuietButton}" Foreground="#B14B50" Padding="0,8"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </StackPanel>
    </Border>
    </ScrollViewer>
   </Grid>
   <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="True">
    <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Aktarımı geri al" Click="Restore_Click" Style="{StaticResource QuietButton}" FontSize="12" Visibility="Collapsed" Padding="12,5"/>
    <TextBlock x:Name="StatusText" Text="Kayıtlar açılıyor…" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </DockPanel>
  </Grid>
 </Grid>
</Window>
